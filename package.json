{
  "name": "django-adminwp-assets",
  "private": true,
  "version": "0.1.0",
  "description": "Build tools for the django-adminwp static assets",
  "scripts": {
    "build:css": "sass --quiet-deps --silence-deprecation=import --no-source-map --style=compressed --load-path=node_modules assets/scss/adminwp.scss src/adminwp/static/adminwp/css/bootstrap.min.css && sass --no-source-map --style=expanded assets/scss/theme.scss src/adminwp/static/adminwp/css/adminwp.css",
    "test:js": "node --test tests/js/*.test.mjs",
    "build:charts": "node scripts/build-charts.mjs"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "echarts": "6.1.0",
    "sass": "1.105.2"
  }
}
